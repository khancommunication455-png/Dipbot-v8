# --- exchange ---
BINANCE_API_KEY=your_testnet_key
BINANCE_API_SECRET=your_testnet_secret
USE_TESTNET=true
CONTROL_TOKEN=            # set a random string to protect close/pause endpoints!
STATE_DB=bot.db
PORT=10000

# --- universe ---
WATCHLIST=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,DOGEUSDT
MARKET_SCAN_ENABLED=false
MARKET_SCAN_TOP_N=30
MARKET_SCAN_REFRESH_LOOPS=15
MARKET_SCAN_MIN_VOLUME_USDT=5000000
CHECK_INTERVAL_SEC=60
KLINE_INTERVAL=15m
ROLLING_WINDOW=20
MAX_CONCURRENT_POSITIONS=3
POSITION_SIZE_USDT=10
MAX_HOLD_HOURS=24

# --- execution ---
FEE_RATE=0.001
MAKER_ORDERS_ENABLED=false
MAKER_WAIT_SEC=20
ENTRY_COOLDOWN_MIN=30

# --- multi-timeframe filter ---
MTF_ENABLED=true
MTF_INTERVAL=4h
MTF_MA_PERIOD=50

# --- strategies ---
STRATEGY_DIP_ENABLED=true
STRATEGY_BB_ENABLED=true
STRATEGY_BREAKOUT_ENABLED=true

# --- portfolio risk ---
DAILY_MAX_LOSS_USDT=15
MAX_DRAWDOWN_PCT=15
CRASH_GUARD_ENABLED=true
CRASH_GUARD_PCT=3
CRASH_GUARD_COOLDOWN_MIN=60
RISK_PER_TRADE_PCT=1.0
MAX_POSITION_PCT=15
MAX_TOTAL_EXPOSURE_PCT=60

# --- telegram (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_COMMANDS_ENABLED=true

# --- discord (optional, alerts only — no remote commands) ---
# Create in Discord: Channel Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=

# --- backtester-only ---
SLIPPAGE_BPS=5
STARTING_EQUITY=1000